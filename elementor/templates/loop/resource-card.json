    "custom_css": ".fs-rcard{overflow:hidden}.fs-rcard[hidden]{display:none!important}.fs-gcard.fs-rcard{--fs-bw:4px;border-radius:28px!important;overflow:hidden;transition:transform .2s ease,box-shadow .2s ease}.fs-gcard.fs-rcard:hover{box-shadow:0 26px 46px -22px rgba(38,39,91,.45);transform:translateY(-4px)}.e-con.fs-li{height:100%;overflow:hidden}.fs-li-img img{aspect-ratio:16/9;display:block;object-fit:cover;width:100%}.e-con.fs-li-body{flex:1 1 auto}.fs-li-body .fs-nostyle>.elementor-widget{flex:none!important;width:auto!important}.fs-li-type .elementor-heading-title{background:var(--fs-sky);border-radius:999px;color:#fff!important;display:inline-flex;font-family:var(--fs-font)!important;font-size:12.5px!important;font-weight:700!important;line-height:1.5!important;padding:4px 12px}.fs-li-type a{color:inherit!important;pointer-events:none;text-decoration:none!important}.category-case-studies .fs-li-type .elementor-heading-title{background:var(--fs-purple)}.category-podcast .fs-li-type .elementor-heading-title{background:var(--fs-grad)}.category-videos .fs-li-type .elementor-heading-title{background:var(--fs-royal)}.fs-li-date .elementor-heading-title{color:var(--fs-muted)!important;font-family:var(--fs-font-ui)!important;font-size:13px!important;font-weight:500!important;margin:0}.fs-li-title .elementor-heading-title{color:var(--fs-purple)!important;font-family:var(--fs-font)!important;font-size:19px!important;font-weight:600!important;line-height:1.3!important;margin:0}.fs-li-title a{color:inherit!important;text-decoration:none!important}.fs-li-ex,.fs-li-ex p{color:var(--fs-body)!important;font-family:var(--fs-font)!important;font-size:15px!important;line-height:1.55!important;margin:0}.fs-li-tags{margin-top:auto!important}.fs-li-tags .elementor-heading-title{border-top:1px solid var(--fs-line);color:var(--fs-muted)!important;font-family:var(--fs-font-ui)!important;font-size:12.5px!important;font-weight:500!important;line-height:1.5!important;margin:0;padding